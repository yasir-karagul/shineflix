generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  MOVIE
  SERIES
  ANIME
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Content {
  id              String            @id @default(cuid())
  imdbId          String?           @unique
  slug            String            @unique
  type            ContentType
  title           String
  originalTitle   String?
  synopsis        String            @default("") @db.Text
  releaseYear     Int?
  endYear         Int?
  runtimeMinutes  Int?
  status          PublicationStatus @default(DRAFT)
  country         String?
  language        String?
  genres          String[]          @default([])
  posterUrl       String?
  backdropUrl     String?
  imdbRating      Float?
  imdbVotes       Int?
  imdbUrl         String?
  embedUrl        String?
  isFeatured      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  seasons         Season[]

  @@index([type, status, releaseYear])
  @@index([title])
}

model Season {
  id           String    @id @default(cuid())
  contentId    String
  seasonNumber Int
  title        String?
  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes     Episode[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([contentId, seasonNumber])
}

model Episode {
  id             String    @id @default(cuid())
  imdbId         String?   @unique
  seasonId       String
  episodeNumber  Int
  title          String
  synopsis       String    @default("") @db.Text
  runtimeMinutes Int?
  releaseDate    DateTime?
  embedUrl       String?
  isPublished    Boolean   @default(false)
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([seasonId, episodeNumber])
  @@index([isPublished, episodeNumber])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, createdAt])
}
