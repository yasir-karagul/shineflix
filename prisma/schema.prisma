generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AdFormat {
  LINK
  IMAGE
  SCRIPT
}

enum AdPlacement {
  SITE_TOP
  HOME_INLINE
  PLAYER_BEFORE
  DETAIL_BOTTOM
}

enum ContentType {
  MOVIE
  SERIES
  ANIME
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Ad {
  id          String      @id @default(cuid())
  title       String
  format      AdFormat
  placement   AdPlacement
  isActive    Boolean     @default(false)
  linkUrl     String?
  imageUrl    String?
  scriptCode  String?     @db.Text
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive, placement])
  @@index([startsAt, endsAt])
}

model Content {
  id              String            @id @default(cuid())
  imdbId          String?           @unique // Legacy IMDb field retained for existing rows; new imports use TMDB.
  tmdbId          Int?
  mediaType       String?
  alternativeTitles String[]         @default([])
  posterPath      String?
  backdropPath    String?
  logoPath        String?
  tmdbStatus      String?
  originalLanguage String?
  voteAverage     Float?
  voteCount       Int?
  slug            String            @unique
  type            ContentType
  title           String
  originalTitle   String?
  synopsis        String            @default("") @db.Text
  overview        String            @default("") @db.Text
  releaseYear     Int?
  endYear         Int?
  runtimeMinutes  Int?
  status          PublicationStatus @default(DRAFT)
  country         String?
  language        String?
  genres          String[]          @default([])
  posterUrl       String?
  backdropUrl     String?
  imdbRating      Float?
  imdbVotes       Int?
  imdbUrl         String?
  embedUrl        String?
  isFeatured      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  seasons         Season[]
  streamServers   StreamServer[]

  @@index([type, status, releaseYear])
  @@index([title])
  @@unique([tmdbId, mediaType])
}

model Season {
  id           String    @id @default(cuid())
  contentId    String
  seasonNumber Int
  title        String?
  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes     Episode[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([contentId, seasonNumber])
}

model Episode {
  id             String    @id @default(cuid())
  imdbId         String?   @unique
  seasonId       String
  episodeNumber  Int
  title          String
  synopsis       String    @default("") @db.Text
  runtimeMinutes Int?
  releaseDate    DateTime?
  embedUrl       String?
  isPublished    Boolean   @default(false)
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  streamServers  StreamServer[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([seasonId, episodeNumber])
  @@index([isPublished, episodeNumber])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, createdAt])
}


model StreamServer {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(100)
  url        String   @db.Text
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  contentId  String?
  episodeId  String?
  content    Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode    Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contentId, sortOrder])
  @@index([episodeId, sortOrder])
}
