generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AdFormat {
  LINK
  IMAGE
  SCRIPT
}

enum AdPlacement {
  SITE_TOP
  HOME_INLINE
  PLAYER_BEFORE
  DETAIL_BOTTOM
}

enum ContentType {
  MOVIE
  SERIES
  ANIME
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Ad {
  id          String      @id @default(cuid())
  title       String
  format      AdFormat
  placement   AdPlacement
  isActive    Boolean     @default(false)
  linkUrl     String?
  imageUrl    String?
  scriptCode  String?     @db.Text
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive, placement])
  @@index([startsAt, endsAt])
}

model IntegrationSetting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id                String            @id @default(cuid())
  tmdbId            Int?
  mediaType         String?
  slug              String            @unique
  type              ContentType
  title             String
  originalTitle     String?
  alternativeTitles String[]          @default([])
  overview          String            @default("") @db.Text @map("synopsis")
  releaseYear       Int?
  endYear           Int?
  runtimeMinutes    Int?
  status            String?           @map("tmdbStatus")
  publicationStatus PublicationStatus @default(DRAFT) @map("status")
  country           String?
  originalLanguage  String?
  genres            String[]          @default([])
  posterPath        String?           @map("posterUrl")
  backdropPath      String?           @map("backdropUrl")
  logoPath          String?
  voteAverage       Float?
  voteCount         Int?
  embedUrl          String?
  isFeatured        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  seasons           Season[]

  @@unique([tmdbId, mediaType])
  @@index([type, publicationStatus, releaseYear])
  @@index([title])
}

model Season {
  id           String    @id @default(cuid())
  contentId    String
  seasonNumber Int
  title        String?
  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes     Episode[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([contentId, seasonNumber])
}

model Episode {
  id             String    @id @default(cuid())
  seasonId       String
  episodeNumber  Int
  title          String
  synopsis       String    @default("") @db.Text
  runtimeMinutes Int?
  releaseDate    DateTime?
  embedUrl       String?
  isPublished    Boolean   @default(false)
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([seasonId, episodeNumber])
  @@index([isPublished, episodeNumber])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, createdAt])
}
