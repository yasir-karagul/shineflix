DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
# Direct (non-pooled) Neon URL for Prisma schema operations (db push / migrate).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-bytes"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
# TMDB official API (prefer the API Read Access Token / Bearer token).
TMDB_ACCESS_TOKEN=""
# Optional fallback: TMDB v3 API key if you do not use the Read Access Token.
TMDB_API_KEY=""

# Comma-separated HTTPS embed hostnames you are authorized to use.
# YouTube and Vimeo player hosts are allowed by default.
EMBED_ALLOWED_HOSTS=""
